# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# Node.js & Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Large ML Model Weights & Archives (>50MB / >100MB GitHub limit)
# Note: Checkpoints are documented in results/experiments/phase16_hardening/model_manifest.json
*.pth
*.pt
*.ckpt
*.h5
*.onnx
*.tar.gz
*.zip
*.tar

# Large Raw Satellite / Orthomosaic Rasters (>100MB)
data/open_cities_raw/ptn/abe1a3/abe1a3.tif
sample/
data/raw/
data/processed*/

# Ephemeral API prototype test directories (keep reference 8b8c724c7e)
results/prototype/api/*
!results/prototype/api/8b8c724c7e/

# IDE & OS Specific
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
